# Copy to infra/compose/.env (gitignored) and fill in.
# Generate a password: openssl rand -hex 16
POSTGRES_PASSWORD=change-me
# Per-service database users (created by postgres/init/01-service-databases.sh)
IDENTITY_DB_PASSWORD=change-me
# Host port for Postgres. 5432 is taken by a native Windows PostgreSQL service.
POSTGRES_HOST_PORT=5433
