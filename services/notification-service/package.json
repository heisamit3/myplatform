    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@testcontainers/mongodb": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.1",
    "oxlint": "^1.87.0",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
